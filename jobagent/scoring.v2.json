{
  "version": 2,
  "name": "Michael career-direction scoring v2",

  "score_range": {
    "min": 0,
    "max": 100
  },

  "dimension_baselines": {
    "qualification": 5,
    "direction": 20,
    "curiosity": 20
  },

  "dimensions": {
    "qualification": {
      "label": "Kan jeg jobbet?",
      "description": "Hvor godt Michaels dokumenterede erfaring og kompetencer matcher jobbet.",
      "weight": 0.30
    },
    "direction": {
      "label": "Er det den rigtige retning?",
      "description": "Hvor godt jobbet matcher ønsket om praktisk, teknisk arbejde med konkrete resultater.",
      "weight": 0.50
    },
    "curiosity": {
      "label": "Vækker det min nysgerrighed?",
      "description": "Hvor sandsynligt det er, at jobbet er interessant, anderledes eller værd at undersøge nærmere.",
      "weight": 0.20
    }
  },

  "overall_score": {
    "method": "weighted_sum",
    "round": true,
    "clamp": true,
    "formula": {
      "qualification": 0.30,
      "direction": 0.50,
      "curiosity": 0.20
    }
  },

  "matching": {
    "case_insensitive": true,
    "normalize_danish_characters": false,
    "use_word_variants": true,
    "match_each_signal_once": true,
    "prefer_longest_phrase": true,
    "title_multiplier": 1.25
  },

  "profile_overlap": {
    "professional_skill": {
      "qualification_per_distinct_match": 5,
      "qualification_cap": 30
    },
    "currently_learning": {
      "qualification_per_distinct_match": 0,
      "direction_per_distinct_match": 2,
      "curiosity_per_distinct_match": 5,
      "direction_cap": 8,
      "curiosity_cap": 15,
      "note": "Currently learning must never count as professional experience or qualification."
    },
    "career_interest": {
      "qualification_per_distinct_match": 0,
      "direction_per_distinct_match": 3,
      "curiosity_per_distinct_match": 2,
      "direction_cap": 9,
      "curiosity_cap": 6
    }
  },

